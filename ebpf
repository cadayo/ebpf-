#!/data/data/com.termux/files/usr/bin/sh

# ==================== 配置区 ====================
BASE_DIR="/data/data/com.termux/files/home/ebpf"
SINGBOX_BIN="$BASE_DIR/sing-box"
CONFIG_FILE="$BASE_DIR/config.json"

# 统一管理运行时文件（日志与 PID）
RUN_DIR="$BASE_DIR/run"
LOG_FILE="$RUN_DIR/singbox_ebpf.log"
PID_FILE="$RUN_DIR/singbox_ebpf.pid"
# ================================================

# 初始化运行时目录
init_env() {
    if [ ! -d "$RUN_DIR" ]; then
        mkdir -p "$RUN_DIR"
    fi
}

start() {
    init_env
    echo "[+] 正在检查 eBPF 环境及配置文件语法..."
    
    # 1. 检查本地文件是否存在
    if [ ! -f "$SINGBOX_BIN" ] || [ ! -f "$CONFIG_FILE" ]; then
        echo "[-] 错误: 找不到 sing-box 或配置文件！"
        exit 1
    fi

    # 2. 以 root 权限挂载 bpf 并检查配置语法
    su -c "
        if [ ! -d '/sys/fs/bpf' ]; then
            mkdir -p /sys/fs/bpf
        fi
        if ! mount | grep -q '/sys/fs/bpf'; then
            mount -t bpf bpf /sys/fs/bpf 2>/dev/null
        fi
        '$SINGBOX_BIN' check -c '$CONFIG_FILE'
    "

    if [ $? -ne 0 ]; then
        echo "[-] 错误: 配置文件语法检查未通过或 eBPF 环境不可用，启动中止！"
        exit 1
    fi

    echo "[+] 正在启动 sing-box (eBPF 模式)..."
    
    # 3. 以 root 权限开启转发并在后台持久运行
    su -c "echo 1 > /proc/sys/net/ipv4/ip_forward && echo 1 > /proc/sys/net/ipv6/conf/all/forwarding && nohup '$SINGBOX_BIN' run -c '$CONFIG_FILE' > '$LOG_FILE' 2>&1 & echo \$! > '$PID_FILE'"

    # 4. 稍等 2 秒检查进程是否存活
    sleep 2
    local is_running=0
    if [ -f "$PID_FILE" ]; then
        local pid
        pid=$(cat "$PID_FILE")
        if su -c "kill -0 $pid 2>/dev/null"; then
            is_running=1
        fi
    fi

    if [ "$is_running" -eq 1 ]; then
        echo "[+] sing-box (eBPF) 启动成功并正在运行！"
    else
        echo "[-] 错误: sing-box 启动后异常退出，错误日志："
        su -c "cat '$LOG_FILE'"
    fi
}

stop() {
    echo "[+] 正在停止 sing-box..."
    su -c "
        # 1. 如果有 PID 文件，尝试发送正常退出信号
        if [ -f '$PID_FILE' ]; then
            PID=\$(cat '$PID_FILE')
            kill \$PID 2>/dev/null
            rm -f '$PID_FILE'
        fi
        
        # 2. 缓冲 1 秒，给 sing-box 足够的时间清理 TUN 网卡和路由规则
        sleep 1
        
        # 3. 暴力兜底清理：忽略 PID，直接按名称强制杀掉所有相关的存活进程
        pkill -9 -f '$SINGBOX_BIN' 2>/dev/null
        # 部分 Android 环境 pkill 失效时，用 killall 作为第二层兜底
        killall -9 sing-box 2>/dev/null
    "
    echo "[+] 停止完成。"
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        sleep 1
        start
        ;;
    *)
        echo "使用方法: ebpf {start|stop|restart}"
        exit 1
        ;;
esac
