#!/data/data/com.termux/files/usr/bin/sh

# ==================== 配置区 ====================
BASE_DIR="/data/data/com.termux/files/home/ebpf"
SINGBOX_BIN="$BASE_DIR/sing-box"
CONFIG_FILE="$BASE_DIR/config.json"

RUN_DIR="$BASE_DIR/run"
LOG_FILE="$RUN_DIR/singbox_ebpf.log"
# ================================================

init_env() {
    if [ ! -d "$RUN_DIR" ]; then
        mkdir -p "$RUN_DIR"
    fi
}

start() {
    init_env
    echo "[+] 正在检查 eBPF 环境及配置文件语法..."
    
    if [ ! -f "$SINGBOX_BIN" ] || [ ! -f "$CONFIG_FILE" ]; then
        echo "[-] 错误: 找不到 sing-box 或配置文件！"
        exit 1
    fi

    su -c "
        if [ ! -d '/sys/fs/bpf' ]; then
            mkdir -p /sys/fs/bpf
        fi
        if ! mount | grep -q '/sys/fs/bpf'; then
            mount -t bpf bpf /sys/fs/bpf 2>/dev/null
        fi
        '$SINGBOX_BIN' check -c '$CONFIG_FILE'
    "

    if [ $? -ne 0 ]; then
        echo "[-] 错误: 配置文件语法检查未通过或 eBPF 环境不可用，启动中止！"
        exit 1
    fi

    echo "[+] 正在启动 sing-box (eBPF 模式)..."
    
    # 直接以 root 后台启动，无需记录 PID
    su -c "echo 1 > /proc/sys/net/ipv4/ip_forward && echo 1 > /proc/sys/net/ipv6/conf/all/forwarding && nohup '$SINGBOX_BIN' run -c '$CONFIG_FILE' > '$LOG_FILE' 2>&1 &"

    sleep 2
    if su -c "pgrep -f '$SINGBOX_BIN'" >/dev/null 2>&1; then
        echo "[+] sing-box (eBPF) 启动成功并正在运行！"
    else
        echo "[-] 错误: sing-box 启动后异常退出，错误日志："
        su -c "cat '$LOG_FILE'"
    fi
}

stop() {
    echo "[+] 正在停止 sing-box (eBPF)..."
    su -c "
        # 1. 检查进程是否存在
        if pgrep -f '$SINGBOX_BIN' >/dev/null 2>&1; then
            echo '[*] 发送退出信号，等待 sing-box 从内核卸载 eBPF 规则...'
            # 发送 SIGTERM (15) 优雅退出信号，触发 sing-box 自行清理内核规则
            pkill -15 -f '$SINGBOX_BIN' 2>/dev/null
            
            # 2. 循环等待进程真正退出（最多等 8 秒）
            count=0
            while pgrep -f '$SINGBOX_BIN' >/dev/null 2>&1 && [ \$count -lt 8 ]; do
                sleep 1
                count=\$((count + 1))
            done
            
            # 3. 超时未退出才强杀兜底
            if pgrep -f '$SINGBOX_BIN' >/dev/null 2>&1; then
                echo '[-] 警告: 进程超时未退出，强行结束并清理网卡...'
                pkill -9 -f '$SINGBOX_BIN' 2>/dev/null
                umount -f /sys/fs/bpf 2>/dev/null
            fi
        else
            echo '[*] sing-box 未在运行。'
        fi
    "
    echo "[+] 停止完成，网络已恢复。"
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        sleep 1
        start
        ;;
    *)
        echo "使用方法: ebpf {start|stop|restart}"
        exit 1
        ;;
esac