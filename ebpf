#!/data/data/com.termux/files/usr/bin/sh

# ==================== 配置区 ====================
BASE_DIR="/data/data/com.termux/files/home/ebpf"
SINGBOX_BIN="$BASE_DIR/sing-box"
CONFIG_FILE="$BASE_DIR/config.json"

# 统一管理运行时文件（日志与 PID）
RUN_DIR="$BASE_DIR/run"
LOG_FILE="$RUN_DIR/singbox_ebpf.log"
PID_FILE="$RUN_DIR/singbox_ebpf.pid"
# ================================================

init_env() {
    if [ ! -d "$RUN_DIR" ]; then
        mkdir -p "$RUN_DIR"
    fi
}

start() {
    init_env
    echo "[+] 正在检查 eBPF 环境及配置文件语法..."
    
    if [ ! -f "$SINGBOX_BIN" ] || [ ! -f "$CONFIG_FILE" ]; then
        echo "[-] 错误: 找不到 sing-box 或配置文件！"
        exit 1
    fi

    su -c "
        if [ ! -d '/sys/fs/bpf' ]; then
            mkdir -p /sys/fs/bpf
        fi
        if ! mount | grep -q '/sys/fs/bpf'; then
            mount -t bpf bpf /sys/fs/bpf 2>/dev/null
        fi
        '$SINGBOX_BIN' check -c '$CONFIG_FILE'
    "

    if [ $? -ne 0 ]; then
        echo "[-] 错误: 配置文件语法检查未通过或 eBPF 环境不可用，启动中止！"
        exit 1
    fi

    echo "[+] 正在启动 sing-box (eBPF 模式)..."
    
    su -c "echo 1 > /proc/sys/net/ipv4/ip_forward && echo 1 > /proc/sys/net/ipv6/conf/all/forwarding && nohup '$SINGBOX_BIN' run -c '$CONFIG_FILE' > '$LOG_FILE' 2>&1 & echo \$! > '$PID_FILE'"

    sleep 2
    local is_running=0
    if [ -f "$PID_FILE" ]; then
        local pid=$(cat "$PID_FILE")
        if su -c "kill -0 $pid 2>/dev/null"; then
            is_running=1
        fi
    fi

    if [ "$is_running" -eq 1 ]; then
        echo "[+] sing-box (eBPF) 启动成功并正在运行！"
    else
        echo "[-] 错误: sing-box 启动后异常退出，错误日志："
        su -c "cat '$LOG_FILE'"
    fi
}

stop() {
    echo "[+] 正在停止 sing-box..."
    su -c "
        # 1. 尝试正常结束进程，让 sing-box 自己触发网络和路由清理逻辑
        if [ -f '$PID_FILE' ]; then
            PID=\$(cat '$PID_FILE')
            if kill -0 \$PID 2>/dev/null; then
                kill -15 \$PID 2>/dev/null  # 发送 SIGTERM (15) 优雅退出信号
                echo '[*] 已发送停止信号，等待 sing-box 清理路由规则与网卡...'
                
                # 循环等待，最多等 5 秒，给它充足的清理时间
                for i in 1 2 3 4 5; do
                    if ! kill -0 \$PID 2>/dev/null; then
                        break
                    fi
                    sleep 1
                done
            fi
            rm -f '$PID_FILE'
        fi

        # 2. 如果 5 秒后进程仍在运行（卡死），再执行暴力清理兜底
        if pgrep -f '$SINGBOX_BIN' > /dev/null 2>&1; then
            echo '[-] 警告: 进程未能优雅退出，正在强制结束...'
            pkill -9 -f '$SINGBOX_BIN' 2>/dev/null
            killall -9 sing-box 2>/dev/null
        fi

        # 3. 还原系统的 IP 转发状态（恢复环境）
        echo 0 > /proc/sys/net/ipv4/ip_forward 2>/dev/null
        echo 0 > /proc/sys/net/ipv6/conf/all/forwarding 2>/dev/null
    "
    echo "[+] 停止完成。"
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        sleep 1
        start
        ;;
    *)
        echo "使用方法: ebpf {start|stop|restart}"
        exit 1
        ;;
esac
