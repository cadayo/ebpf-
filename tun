#!/data/data/com.termux/files/usr/bin/sh

# ==================== 配置区 ====================
BASE_DIR="/data/data/com.termux/files/home/tun"
SINGBOX_BIN="$BASE_DIR/sing-box"
CONFIG_FILE="$BASE_DIR/config.json"
TUN_NAME="wlan999" # 若检测不到网卡，建议改为 tun0

# 统一管理运行时文件（日志与 PID）
RUN_DIR="$BASE_DIR/run"
LOG_FILE="$RUN_DIR/singbox_tun.log"
PID_FILE="$RUN_DIR/singbox_tun.pid"
# ================================================

init_env() {
    if [ ! -d "$RUN_DIR" ]; then
        mkdir -p "$RUN_DIR"
    fi
}

start() {
    init_env
    echo "[+] 正在检查配置文件语法..."
    
    if [ ! -f "$SINGBOX_BIN" ] || [ ! -f "$CONFIG_FILE" ]; then
        echo "[-] 错误: 找不到 sing-box 或配置文件！"
        exit 1
    fi

    # 1. 语法检查
    su -c "'$SINGBOX_BIN' check -c '$CONFIG_FILE'"
    if [ $? -ne 0 ]; then
        echo "[-] 错误: 配置文件语法检查未通过，启动中止！"
        exit 1
    fi

    echo "[+] 正在启动 sing-box (TUN 模式)..."
    
    # 2. 开启内核转发并在后台运行
    su -c "echo 1 > /proc/sys/net/ipv4/ip_forward && echo 1 > /proc/sys/net/ipv6/conf/all/forwarding && nohup '$SINGBOX_BIN' run -c '$CONFIG_FILE' > '$LOG_FILE' 2>&1 & echo \$! > '$PID_FILE'"

    if [ $? -ne 0 ]; then
        echo "[-] 错误: Root 启动指令执行失败。"
        exit 1
    fi

    echo "[*] 等待 TUN 接口 '$TUN_NAME' 就绪..."
    local count=0
    local found=0
    
    while [ "$count" -lt 5 ]; do
        sleep 2
        # 实时检测进程是否崩溃
        if [ -f "$PID_FILE" ]; then
            local pid=$(cat "$PID_FILE")
            if ! su -c "kill -0 $pid 2>/dev/null"; then
                echo "[-] 错误: sing-box 启动后异常退出，错误日志："
                su -c "cat '$LOG_FILE'"
                return 1
            fi
        fi

        if su -c "ip link show $TUN_NAME" >/dev/null 2>&1; then
            found=1
            break
        fi
        count=$((count + 1))
    done

    if [ "$found" -eq 1 ]; then
        echo "[+] sing-box 启动成功，虚拟网卡 '$TUN_NAME' 已就绪！"
    else
        echo "[-] 警告: 未在规定时间内检测到接口 '$TUN_NAME'，最新日志："
        su -c "tail -n 20 '$LOG_FILE'"
    fi
}

stop() {
    echo "[+] 正在停止 sing-box..."
    su -c "
        # 1. 尝试正常结束进程，让 sing-box 自己触发网络和路由清理逻辑
        if [ -f '$PID_FILE' ]; then
            PID=\$(cat '$PID_FILE')
            if kill -0 \$PID 2>/dev/null; then
                kill -15 \$PID 2>/dev/null  # 发送 SIGTERM (15) 优雅退出信号
                echo '[*] 已发送停止信号，等待 sing-box 清理路由规则与网卡...'
                
                # 循环等待，最多等 5 秒，给它充足的清理时间
                for i in 1 2 3 4 5; do
                    if ! kill -0 \$PID 2>/dev/null; then
                        break
                    fi
                    sleep 1
                done
            fi
            rm -f '$PID_FILE'
        fi

        # 2. 如果 5 秒后进程仍在运行（卡死），再执行暴力清理兜底
        if pgrep -f '$SINGBOX_BIN' > /dev/null 2>&1; then
            echo '[-] 警告: 进程未能优雅退出，正在强制结束...'
            pkill -9 -f '$SINGBOX_BIN' 2>/dev/null
            killall -9 sing-box 2>/dev/null
        fi

        # 3. 还原系统的 IP 转发状态（恢复环境）
        echo 0 > /proc/sys/net/ipv4/ip_forward 2>/dev/null
        echo 0 > /proc/sys/net/ipv6/conf/all/forwarding 2>/dev/null
    "
    echo "[+] 停止完成。"
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        sleep 1
        start
        ;;
    *)
        echo "使用方法: tun {start|stop|restart}"
        exit 1
        ;;
esac
