#!/data/data/com.termux/files/usr/bin/sh

# ==================== 配置区 ====================
BASE_DIR="/data/data/com.termux/files/home/tun"
SINGBOX_BIN="$BASE_DIR/sing-box"
CONFIG_FILE="$BASE_DIR/config.json"
TUN_NAME="wlan999" # 若检测不到网卡，建议改为 tun0

# 统一管理运行时文件（日志）
RUN_DIR="$BASE_DIR/run"
LOG_FILE="$RUN_DIR/singbox_tun.log"
# ================================================

init_env() {
    if [ ! -d "$RUN_DIR" ]; then
        mkdir -p "$RUN_DIR"
    fi
}

start() {
    init_env
    echo "[+] 正在检查配置文件语法..."
    
    if [ ! -f "$SINGBOX_BIN" ] || [ ! -f "$CONFIG_FILE" ]; then
        echo "[-] 错误: 找不到 sing-box 或配置文件！"
        exit 1
    fi

    # 1. 语法检查
    su -c "'$SINGBOX_BIN' check -c '$CONFIG_FILE'"
    if [ $? -ne 0 ]; then
        echo "[-] 错误: 配置文件语法检查未通过，启动中止！"
        exit 1
    fi

    echo "[+] 正在启动 sing-box (TUN 模式)..."
    
    # 2. 开启内核转发并在后台运行
    su -c "echo 1 > /proc/sys/net/ipv4/ip_forward && echo 1 > /proc/sys/net/ipv6/conf/all/forwarding && nohup '$SINGBOX_BIN' run -c '$CONFIG_FILE' > '$LOG_FILE' 2>&1 &"

    echo "[*] 等待 TUN 接口 '$TUN_NAME' 就绪..."
    local count=0
    local found=0
    
    while [ "$count" -lt 5 ]; do
        sleep 2
        # 通过进程名称实时检测进程是否崩溃
        if ! su -c "pgrep -f '$SINGBOX_BIN'" >/dev/null 2>&1; then
            echo "[-] 错误: sing-box 启动后异常退出，错误日志："
            su -c "cat '$LOG_FILE'"
            return 1
        fi

        if su -c "ip link show $TUN_NAME" >/dev/null 2>&1; then
            found=1
            break
        fi
        count=$((count + 1))
    done

    if [ "$found" -eq 1 ]; then
        echo "[+] sing-box 启动成功，虚拟网卡 '$TUN_NAME' 已就绪！"
    else
        echo "[-] 警告: 未在规定时间内检测到接口 '$TUN_NAME'，最新日志："
        su -c "tail -n 20 '$LOG_FILE'"
    fi
}

stop() {
    echo "[+] 正在停止 sing-box (TUN)..."
    su -c "
        # 1. 检查进程是否存在
        if pgrep -f '$SINGBOX_BIN' >/dev/null 2>&1; then
            echo '[*] 发送优雅退出信号，等待 sing-box 注销 TUN 网卡与系统路由...'
            # 发送 SIGTERM (15) 优雅退出信号，触发 sing-box 自行清理 TUN 网卡与路由
            pkill -15 -f '$SINGBOX_BIN' 2>/dev/null
            
            # 2. 循环等待进程真正退出（最多等 8 秒）
            count=0
            while pgrep -f '$SINGBOX_BIN' >/dev/null 2>&1 && [ \$count -lt 8 ]; do
                sleep 1
                count=\$((count + 1))
            done
            
            # 3. 超时未退出才强杀兜底，并强制删除 TUN 虚拟网卡接口
            if pgrep -f '$SINGBOX_BIN' >/dev/null 2>&1; then
                echo '[-] 警告: 进程超时未退出，强行结束并强制清理 TUN 网卡...'
                pkill -9 -f '$SINGBOX_BIN' 2>/dev/null
                ip link delete '$TUN_NAME' 2>/dev/null
                ip link delete tun0 2>/dev/null
            fi
        else
            echo '[*] sing-box 未在运行。'
        fi

        # 4. 恢复 IP 转发状态
        echo 0 > /proc/sys/net/ipv4/ip_forward 2>/dev/null
        echo 0 > /proc/sys/net/ipv6/conf/all/forwarding 2>/dev/null
    "
    echo "[+] 停止完成，网络已恢复。"
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        sleep 1
        start
        ;;
    *)
        echo "使用方法: tun {start|stop|restart}"
        exit 1
        ;;
esac